{
  "name": "mae-cap-backend",
  "version": "1.0.0",
  "description": "MAE Autonomous Customer Data Operations Platform - CAP Backend",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "start": "node node_modules/@sap/cds/bin/cds-serve.js",
    "start:local": "cds watch",
    "build": "cds build --production",
    "postinstall": "node scripts/apply-shim.js",
    "test": "jest --forceExit --detectOpenHandles",
    "test:unit": "jest --testPathPattern=test/unit --forceExit",
    "test:integration": "jest --testPathPattern=test/integration --forceExit",
    "lint": "eslint srv db --ext .js,.cds",
    "seed": "node scripts/seed-data.js",
    "seed:demo": "node scripts/seed-data.js --scenario=demo",
    "seed:performance": "node scripts/seed-data.js --scenario=performance --count=100000"
  },
  "dependencies": {
    "@cap-js/sqlite": "^1.7.0",
    "@sap-cloud-sdk/connectivity": "^3.13.0",
    "@sap-cloud-sdk/http-client": "^3.13.0",
    "@sap-cloud-sdk/resilience": "^3.13.0",
    "@sap/cds": "^7.9.0",
    "@sap/xssec": "^3.6.0",
    "axios": "^1.6.7",
    "csv-parser": "^3.0.0",
    "csv-writer": "^1.6.0",
    "dayjs": "^1.11.10",
    "express": "^4.18.2",
    "node-cron": "^3.0.3",
    "p-limit": "^4.0.0",
    "passport": "^0.7.0",
    "sql.js": "^1.15.1",
    "uuid": "^9.0.0",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@faker-js/faker": "^8.4.1",
    "@sap/cds-dk": "^7.9.0",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "testTimeout": 60000,
    "collectCoverageFrom": [
      "srv/**/*.js",
      "!srv/**/*.test.js"
    ],
    "coverageThreshold": {
      "global": {
        "lines": 70
      }
    }
  },
  "cds": {
    "requires": {
      "db": {
        "kind": "sqlite",
        "credentials": {
          "url": ":memory:"
        }
      },
      "auth": {
        "kind": "dummy"
      },
      "AICORE_SERVICE": {
        "kind": "rest",
        "[production]": {
          "kind": "aicore"
        }
      }
    },
    "build": {
      "target": "gen"
    },
    "server": {
      "port": 8080,
      "cors": true
    },
    "features": {
      "odata_new_parser": true
    }
  }
}
