{
  "authenticationMethod": "none",
  "routes": [
    {
      "source": "^/health$",
      "target": "/health",
      "destination": "mae-cap-backend",
      "authenticationType": "none"
    },
    {
      "source": "^/api/(.*)$",
      "target": "/api/$1",
      "destination": "mae-cap-backend",
      "authenticationType": "none"
    },
    {
      "source": "^/odata/(.*)$",
      "target": "/odata/$1",
      "destination": "mae-cap-backend",
      "authenticationType": "none"
    },
    {
      "source": "^/(.*)$",
      "target": "/$1",
      "localDir": "webapp",
      "authenticationType": "none"
    }
  ]
}
